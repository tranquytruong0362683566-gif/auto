{
  "manifest_version": 3,
  "name": "TQT Page Reels & Group Scanner",
  "version": "1.0.0",
  "description": "Kết nối GitHub Pages với phiên Facebook để đăng Reels Page và quét link bài viết nhóm.",
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://business.facebook.com/*",
    "https://graph.facebook.com/*",
    "https://rupload.facebook.com/*",
    "https://upload.facebook.com/*",
    "https://upload-business.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TQT Page Automation"
  },
  "content_scripts": [
    {
      "matches": [
        "https://tranquytruong0362683566-gif.github.io/auto/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.facebook.com/groups/*"
      ],
      "js": [
        "facebook-scanner.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
